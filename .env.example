# Production Firebase App Check reCAPTCHA v3 Site Key (public site key only).
# Required in production builds when ENFORCE_APP_CHECK=true on Cloud Functions
# and App Check enforcement is enabled for Cloud Firestore in Firebase Console.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Development-only App Check debug token ("true" to auto-generate, or a registered UUID).
# Active ONLY when import.meta.env.DEV is true. NEVER commit real debug tokens or .env files.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
